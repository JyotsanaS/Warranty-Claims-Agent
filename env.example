# ── LLM Gateway (LiteLLM) ────────────────────────────────────────────────────
# All model calls go through LiteLLM. Change provider/model here — zero code changes.
# Format: <provider>/<model-id>
# Text generation examples:
#   groq/llama-3.1-8b-instant          (current — free Groq)
#   openai/gpt-4o-mini                 (OpenAI swap)
#   anthropic/claude-haiku-4-5         (Anthropic swap)
#   ollama/llama3                      (fully local swap)
# Embedding examples:
#   local/BAAI/bge-small-en-v1.5       (current — local sentence-transformers, free)
#   openai/text-embedding-3-small      (OpenAI swap)
#   huggingface/BAAI/bge-small-en-v1.5 (HuggingFace Inference API swap)

GROQ_API_KEY=your_groq_api_key_here

# Text generation models
LLM_FAST_MODEL=groq/llama-3.1-8b-instant
LLM_MAIN_MODEL=groq/llama-3.3-70b-versatile
LLM_VISION_MODEL=groq/meta-llama/llama-4-scout-17b-16e-instruct

# Embedding model
# "local/" prefix = sentence-transformers (no API key, runs in-process)
# Any other prefix = routed through litellm.embedding()
LLM_EMBEDDING_MODEL=BAAI/bge-m3
LLM_EMBEDDING_DIMENSIONS=1024

# ── Vector Store (Pinecone) ───────────────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=voltedge-warranty
PINECONE_NAMESPACE=warranty_policy_v1

# ── Image Storage (local filesystem) ─────────────────────────────────────────
# Images are stored locally under this directory.
# Naming convention: {session_id}_{type}_{timestamp}.{ext}
# Types: damage | receipt | serial
# Example: sess_abc123_damage_20260331T143022.jpg
IMAGE_UPLOAD_DIR=./data/images

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
MAX_TOKENS_PER_SESSION=8000
RAG_SIMILARITY_THRESHOLD=0.75
RAG_TOP_K=5
IMAGE_MAX_SIZE_MB=10
